  <widget class="QLabel" name="label">
   <property name="geometry">
    <rect>
     <x>20</x>
     <y>20</y>
     <width>361</width>
     <height>511</height>
    </rect>
   </property>
   <property name="text">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot; font-size:18pt; font-weight:700;&quot;&gt;Tutorial&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;Welcome to GeoBreaker! Learn about other countries and geography, and put your knowledge to the test by playing a &amp;quot;brick-breaking&amp;quot; game!&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;Click Play! to start the game. This will take you to a world map where you can click on pins to learn about different countries.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;Once you have learned about the countries, click on the Enter Game button to start the game.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:11pt; font-weight:700;&quot;&gt;Game Play&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;A question will appear at the top. To earn points, aim the ball at the brick that contains the correct answer to the question. To aim, click and drag, then release to fire the ball. You will earn points for getting the right answer, and you will lose points if you hit the wrong answer.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;The questions are categorized by countries, and each will have five questions/rounds. &lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;Get the highest score to win!&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="wordWrap">
    <bool>true</bool>
   </property>
  </widget>
 </widget>
